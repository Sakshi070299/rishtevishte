{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && pnpm install --no-frozen-lockfile --filter rishtenate-backend...",
  "buildCommand": "pnpm exec prisma generate && pnpm exec nest build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
