# =====================================================================
# RishteNate Backend — .env.example
# Designed for: Vercel (serverless) + Neon (free Postgres)
# Copy this to `.env` for local dev, and add the same vars to Vercel
# Project Settings -> Environment Variables for production.
# =====================================================================

# ─── Database (Neon free tier) ───
# Get this from https://console.neon.tech (Project -> Connection Details)
# IMPORTANT for serverless on Vercel: use the *pooled* connection string
# (it ends with `-pooler` in the host) and add `?sslmode=require&pgbouncer=true&connect_timeout=15`.
# Example:
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/rishtenate?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL="postgresql://user:password@HOST-pooler.REGION.aws.neon.tech/rishtenate?sslmode=require&pgbouncer=true&connect_timeout=15"

# Optional: a *direct* (non-pooled) URL used by Prisma migrations only.
# This is the same connection string but WITHOUT `-pooler` in the host.
# DIRECT_URL="postgresql://user:password@HOST.REGION.aws.neon.tech/rishtenate?sslmode=require"

# ─── JWT ───
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRY="5h"

# ─── OTP ───
OTP_PROVIDER="mock"
# OTP_PROVIDER="msg91"
# MSG91_AUTH_KEY="your_msg91_auth_key"
# MSG91_FLOW_ID="your_flow_id"
# MSG91_SENDER_ID="RSHTSETU"
# MSG91_ROUTE="4"
# MSG91_WA_NUMBER="your_whatsapp_number"

# ─── Email ───
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_app_password"
# SMTP_FROM="noreply@example.com"

# ─── Razorpay ───
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_from_razorpay_dashboard"

# ─── reCAPTCHA ───
# RECAPTCHA_SECRET_KEY="your_recaptcha_v3_secret_key"

# ─── App ───
# PORT is only used for local `pnpm start:dev`. Vercel ignores it.
PORT=4000
# Comma-separated list of allowed origins (frontend URLs).
# In production, set this to your Vercel frontend domain.
FRONTEND_URL="http://localhost:3000,https://rishtenate-frontend.vercel.app"
NODE_ENV="development"

# ─── Admin Notifications ───
# ADMIN_NOTIFICATION_MOBILE="9999999999"

# ─── File Upload ───
# Local disk works for dev only — Vercel serverless has an ephemeral
# filesystem, so for production switch to S3 or R2 (free tier on Cloudflare R2
# gives 10 GB / month). Keep "local" while iterating.
UPLOAD_PROVIDER="local"
# UPLOAD_PROVIDER="s3"
# AWS_S3_BUCKET="rishtenate-photos"
# AWS_S3_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# UPLOAD_PROVIDER="r2"
# R2_ACCOUNT_ID=""
# R2_BUCKET_NAME="rishtenate-photos"
# R2_ACCESS_KEY=""
# R2_SECRET_KEY=""
# R2_PUBLIC_DOMAIN="pub-xxxx.r2.dev"
